# Server
PORT=3100
NODE_ENV=development

# Database (separate GBR database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gbr
DB_USER=postgres
DB_PASSWORD=yourpassword

# Auth
JWT_SECRET=change-this-to-a-long-random-string
OWNER_PIN=1234

# Public URL (where the app is hosted)
APP_URL=http://localhost:3100

# Twilio SMS (optional - leave blank to disable SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (quarterly reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
REPORT_EMAIL=owner@example.com

# Business Info
BUSINESS_NAME=Andrew McCulloch Jewellers
BUSINESS_ADDRESS=7 The Square, Beeston NG9 2JG
BUSINESS_TEL=0115 925 7552
